<section id="start" class="hero">
  <div class="u-container hero-grid">
    <div class="hero-text">
      <p class="u-kicker hero-line" style="--line: 0">Frederik Anspach IT &amp; Softwaresysteme</p>

      <h1 class="u-serif hero-title">
        <span class="hero-line" style="--line: 1">Software für Nachweise,</span>
        <span class="hero-line" style="--line: 2">die halten.</span>
      </h1>

      <p class="hero-sub hero-line" style="--line: 3">
        Ich entwickle Anwendungen, in denen jede Änderung an den Daten sichtbar bleibt. Angefangen
        habe ich mit der Zeiterfassung.
      </p>

      <div class="hero-actions hero-line" style="--line: 4">
        <a class="u-btn u-btn-primary" href="https://mytid.de">Zu MyTid</a>
        <a class="u-btn u-btn-outline" href="#kontakt">Kontakt</a>
      </div>
    </div>

    <figure class="hero-photo">
      <img
        src="/img/frederik-01.webp"
        alt="Frederik Anspach"
        width="864"
        height="1106"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
  </div>
</section>
