---
const products = [
  {
    name: "MyTid",
    status: "Öffentliche Beta",
    active: true,
    text: "Zeiterfassung für Angestellte, Selbstständige und Freiberufler. Im Browser und als App, auch offline.",
    href: "https://mytid.de",
    linkLabel: "mytid.de",
  },
  {
    name: "OTid",
    status: "In Entwicklung",
    active: false,
    text: "Für Unternehmen: fasst die Zeiten des Teams zusammen und bereitet sie für die Lohnabrechnung auf. Bisher nur als Demo mit Beispieldaten.",
    href: "https://mytid.de/otid",
    linkLabel: "mytid.de/otid",
  },
  {
    name: "API.MyTid",
    status: "Geplant",
    active: false,
    text: "Eine Schnittstelle, um Zeitdaten an andere Systeme zu übergeben. Kommt nach OTid.",
    href: "https://mytid.de/api",
    linkLabel: "mytid.de/api",
  },
];
---

<section id="produkte" class="u-section">
  <div class="u-container">
    <h2 class="u-serif u-h2 reveal">Produkte</h2>
    <ul class="products">
      {
        products.map((product, index) => (
          <li class="reveal" style={`--reveal-delay: ${index * 0.1}s`}>
            <a class="product-row" href={product.href}>
              <span class="product-name u-serif">{product.name}</span>
              <span class:list={["product-status", { "is-active": product.active }]}>
                {product.status}
              </span>
              <span class="product-text">
                {product.text}
                <span class="product-link">
                  {product.linkLabel}
                  <span class="product-arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
