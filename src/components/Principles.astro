---
const principles = [
  {
    title: "Änderungen bleiben sichtbar",
    text: "Jeder Eintrag ist mit dem vorherigen verknüpft. Nachträgliche Korrekturen sind möglich, aber sie werden protokolliert.",
  },
  {
    title: "Nur die nötigen Daten",
    text: "Die Grundversion von MyTid braucht kein Konto und speichert nur auf dem eigenen Gerät. Wer Sicherung und Abgleich nutzt, überträgt nur verschlüsselte Daten.",
  },
  {
    title: "Keine Werbung",
    text: "Die Grundversion von MyTid ist kostenlos und bleibt werbefrei. Kosten entstehen nur für Zusatzleistungen wie Sicherung, Abgleich zwischen Geräten und die Firmenversion.",
  },
];
---

<section id="arbeitsweise" class="u-section">
  <div class="u-container">
    <h2 class="u-serif u-h2 reveal">Wie ich arbeite</h2>
    <ol class="principles">
      {
        principles.map((principle, index) => (
          <li class="principle reveal" style={`--reveal-delay: ${index * 0.1}s`}>
            <span class="principle-num u-serif" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="principle-title">{principle.title}</h3>
            <p class="u-body">{principle.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
