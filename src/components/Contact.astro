---
---

<section id="kontakt" class="u-section">
  <div class="u-container split-grid">
    <div class="reveal">
      <h2 class="u-serif u-h2">Kontakt</h2>
      <p class="u-body mt-6 max-w-md">
        Fragen zu MyTid, Interesse an OTid für Ihr Unternehmen oder eine Idee für eine
        Zusammenarbeit? Schreiben Sie mir, ich antworte selbst.
      </p>
      <p class="mt-8">
        <a class="u-link contact-mail u-serif" href="mailto:kontakt@frederik-anspach.de">
          kontakt@frederik-anspach.de
        </a>
      </p>
    </div>

    <form class="contact-form reveal" data-contact-form novalidate style="--reveal-delay: 0.1s">
      <div class="pot-field" aria-hidden="true">
        <label for="pot">Bitte leer lassen</label>
        <input type="text" id="pot" name="pot" tabindex="-1" autocomplete="off" />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div class="form-field">
          <label for="form-name">Name</label>
          <input type="text" id="form-name" name="name" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="form-email">E-Mail</label>
          <input type="email" id="form-email" name="email" autocomplete="email" required />
        </div>
      </div>

      <div class="form-field">
        <label for="form-message">Nachricht</label>
        <textarea id="form-message" name="message" rows="6" required></textarea>
      </div>

      <div class="form-check">
        <input type="checkbox" id="form-privacy" name="privacy" required />
        <label for="form-privacy">
          Ich akzeptiere die{" "}
          <a href="/datenschutz.html" class="u-link-inline" target="_blank">Datenschutzerklärung</a>.
        </label>
      </div>

      <div>
        <button type="submit" class="u-btn u-btn-primary">Nachricht senden</button>
      </div>
    </form>
  </div>
</section>
