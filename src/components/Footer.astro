---
const year = new Date().getFullYear();

const links = [
  { label: "Impressum", href: "/impressum.html" },
  { label: "Datenschutz", href: "/datenschutz.html" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/frederik-anspach/", external: true },
  { label: "GitHub", href: "https://github.com/frederikanspach", external: true },
];
---

<footer class="site-footer">
  <div class="u-container site-footer-inner">
    <p>© {year} Frederik Anspach IT &amp; Softwaresysteme</p>
    <nav aria-label="Footer-Navigation">
      <ul class="site-footer-links">
        {
          links.map((link) => (
            <li>
              <a
                class="u-link"
                href={link.href}
                rel={link.external ? "noopener" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
