---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/public-sans/wght.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  withStructuredData?: boolean;
}

const { title, description, path = "/", withStructuredData = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;

// Strukturierte Daten bewusst knapp: Person und Organisation, keine Produktbehauptungen
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://frederik-anspach.de/#person",
      name: "Frederik Anspach",
      url: "https://frederik-anspach.de",
      image: "https://frederik-anspach.de/img/frederik-01.webp",
      worksFor: { "@id": "https://frederik-anspach.de/#organization" },
      sameAs: [
        "https://www.linkedin.com/in/frederik-anspach/",
        "https://github.com/frederikanspach",
      ],
    },
    {
      "@type": "Organization",
      "@id": "https://frederik-anspach.de/#organization",
      name: "Frederik Anspach IT & Softwaresysteme",
      url: "https://frederik-anspach.de",
      email: "kontakt@frederik-anspach.de",
      founder: { "@id": "https://frederik-anspach.de/#person" },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Vordorf",
        addressRegion: "Niedersachsen",
        addressCountry: "DE",
      },
      areaServed: "DE",
      sameAs: [
        "https://www.linkedin.com/in/frederik-anspach/",
        "https://github.com/frederikanspach",
      ],
    },
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Setzt data-theme vor dem CSS, extern wegen CSP (script-src 'self') -->
    <script is:inline src="/theme-init.js"></script>
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Frederik Anspach IT &amp; Softwaresysteme" />
    <meta property="og:image" content={new URL("/img/frederik-01.webp", Astro.site).href} />
    <meta property="og:image:alt" content="Frederik Anspach" />
    <meta name="twitter:card" content="summary" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      withStructuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:bg-ink focus:px-4 focus:py-3 focus:text-paper"
    >
      Zum Inhalt springen
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/main.ts"></script>
  </body>
</html>
